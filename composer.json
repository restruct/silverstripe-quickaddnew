{
    "name": "restruct/silverstripe-quickaddnew",
    "description": "Add New button for Silverstripe relation fields: create a related record in a dialog and have it selected, without leaving the form",
    "keywords": [
        "silverstripe",
        "silverstripe-module",
        "silverstripe-cms",
        "forms",
        "form-fields",
        "relations",
        "dialog"
    ],
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Shea Dawson",
            "email": "shea@silverstripe.com.au"
        },
        {
            "name": "LeKoala",
            "email": "thomas@lekoala.be"
        },
        {
            "name": "Restruct",
            "email": "dev@restruct.nl",
            "homepage": "https://restruct.nl",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/vendor-plugin": "^3"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^4",
        "squizlabs/php_codesniffer": "^3.5"
    },
    "extra": {
        "expose": [
            "client"
        ],
        "branch-alias": {
            "dev-main": "3.x-dev"
        }
    },
    "replace": {
        "silverstripe/quickaddnew": "*",
        "sheadawson/quickaddnew": "*"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "scripts": {
        "lint": "phpcs src/ tests/",
        "lint-clean": "phpcbf src/ tests/",
        "test": "phpunit -v"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ],
    "autoload": {
        "psr-4": {
            "Restruct\\Silverstripe\\QuickAddNew\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\Silverstripe\\QuickAddNew\\Tests\\": "tests/"
        }
    }
}
